{
  "name": "cargo-stats",
  "version": "1.0.34",
  "description": "Cargo Stats — Telemetria ETS2/ATS",
  "main": "main.js",
  "author": "Cargo Stats",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "npm run rebuild:server && electron-builder",
    "publish": "npm run rebuild:server && electron-builder --publish always",
    "rebuild:server": "npx @electron/rebuild --version 30.5.1 -f",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.cargostats.app",
    "productName": "Cargo Stats",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "steam-auth.js",
      "telemetry-bridge.js",
      "build/*.png",
      "build/*.ico"
    ],
    "asarUnpack": [
      "plugins/**"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "server",
        "filter": [
          "**/*",
          "!*.db*",
          "!*.log",
          "!uploads/**",
          "!backups/**",
          "!electron-app/**",
          "!.git/**",
          "!node_modules/**"
        ]
      },
      {
        "from": "node_modules",
        "to": "server/node_modules",
        "filter": [
          "better-sqlite3/**",
          "bcryptjs/**",
          "qrcode/**",
          "bindings/**",
          "file-uri-to-path/**"
        ]
      },
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "**/*",
          "!README.md"
        ]
      },
      {
        "from": "native/build/Release/telemetry-addon.node",
        "to": "native/telemetry-addon.node"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "mapabrasiltruck-cmyk",
      "repo": "cargo-stats"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cargo Stats",
      "artifactName": "Cargo.Stats.Setup.${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "license": "build/termos-de-uso.txt"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.1",
    "electron-updater": "^6.0.0",
    "node-addon-api": "^8.9.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^30.0.0",
    "electron-builder": "^25.0.0"
  }
}
