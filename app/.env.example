# Cargo Stats - Configuracoes
# Copie para .env e ajuste conforme necessario

# Porta do servidor (padrao: 3000)
PORT=3000

# Caminho do banco de dados SQLite
CARGOSTATS_DB_PATH=./data.db

# Caminho dos uploads de fotos/logos
CARGOSTATS_UPLOADS_PATH=./uploads

# Modo de execucao (production/development)
NODE_ENV=production

# Habilitar logs detalhados (true/false)
DEBUG=false

# Chave secreta para sincronizar com o servidor remoto (Hostinger)
# Deve ser a mesma configurada no servidor remoto em api/config.php
SYNC_SECRET=

# URL do servidor de telemetria ETS2/ATS
# ETS2_SERVER_URL=http://localhost:25555

# Credenciais do admin (usadas no seed inicial se ADMIN_EMAIL estiver definido)
# ADMIN_EMAIL=admin@cargostats.com
# ADMIN_PASSWORD=admin123

# Configuracoes do Mercado Pago (para sistema premium)
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_PUBLIC_KEY=
# MERCADO_PAGO_WEBHOOK_SECRET=
